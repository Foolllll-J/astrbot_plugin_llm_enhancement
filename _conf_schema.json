{
    "group_whitelist": {
        "description": "群聊白名单",
        "hint": "仅在群聊白名单里的群启用本插件功能，不填表示所有群聊都启用。",
        "type": "list",
        "default": []
    },
    "intelligent_wake": {
        "type": "object",
        "description": "智能唤醒",
        "hint": "配置智能唤醒相关参数。",
        "items": {
            "wake_triggers": {
                "type": "object",
                "description": "唤醒条件",
                "hint": "配置各类主动唤醒的触发条件。",
                "items": {
                    "prob_wake": {
                        "description": "概率唤醒活跃度",
                        "hint": "数值越高，Bot 在普通群消息中的主动插话意愿越强。设为 0 时关闭。",
                        "type": "float",
                        "default": 0.3,
                        "slider": {
                            "min": 0,
                            "max": 1,
                            "step": 0.1
                        }
                    },
                    "mention_wake": {
                        "description": "提及唤醒规则",
                        "hint": "支持普通文本包含与 re:pattern（正则）。不填时关闭提及检测。",
                        "type": "list",
                        "default": []
                    },
                    "relevant_wake": {
                        "description": "相关性唤醒阈值",
                        "hint": "当前消息与上文 Bot 的消息相关性超过阈值时，唤醒 Bot。设为 0 时关闭检测。",
                        "type": "float",
                        "default": 0.68,
                        "slider": {
                            "min": 0,
                            "max": 1,
                            "step": 0.1
                        }
                    },
                    "ask_wake": {
                        "description": "答疑唤醒阈值",
                        "hint": "当群里有人问专业性问题时，唤醒 Bot。设为 0 时关闭检测。",
                        "type": "float",
                        "default": 0.78,
                        "slider": {
                            "min": 0,
                            "max": 1,
                            "step": 0.1
                        }
                    },
                    "bored_wake": {
                        "description": "无聊唤醒阈值",
                        "hint": "当群里出现无聊/冷场/求聊天等表达时，唤醒 Bot。设为 0 时关闭检测。",
                        "type": "float",
                        "default": 0.74,
                        "slider": {
                            "min": 0,
                            "max": 1,
                            "step": 0.1
                        }
                    },
                    "active_wake_silence_bonus_enabled": {
                        "description": "主动唤醒沉默补偿",
                        "hint": "开启后，Bot 距离上次回复后累积的消息越多，会更容易触发语义型主动唤醒。",
                        "type": "bool",
                        "default": true
                    }
                }
            },
            "wake_judge": {
                "type": "object",
                "description": "唤醒判定",
                "hint": "唤醒触发后经过模型再判定。",
                "items": {
                    "wake_judge_types": {
                        "description": "唤醒判定类型",
                        "hint": "选择后，这些唤醒类型会在触发后再经过一次唤醒判定。留空表示不额外判定。",
                        "type": "list",
                        "options": [
                            "explicit",
                            "prob",
                            "mention",
                            "relevant",
                            "ask",
                            "bored"
                        ],
                        "labels": [
                            "显式唤醒",
                            "概率唤醒",
                            "提及唤醒",
                            "相关性唤醒",
                            "答疑唤醒",
                            "无聊唤醒"
                        ],
                        "default": [
                            "prob"
                        ]
                    },
                    "wake_judge_provider_id": {
                        "description": "唤醒判定 Provider ID",
                        "type": "string",
                        "_special": "select_provider",
                        "default": "",
                        "hint": "用于选中的各类唤醒类型的后置判定。留空表示不启用该判定。"
                    },
                    "wake_judge_prompt": {
                        "description": "唤醒判定提示词",
                        "type": "text",
                        "obvious_hint": true,
                        "editor_mode": true,
                        "editor_language": "markdown",
                        "editor_theme": "vs-dark",
                        "default": "你是群聊“唤醒判定器”。请判断机器人是否应该响应这条显式唤醒请求。\n\n[当前时间]\n{time}\n\n[用户ID]\n{user_id}\n\n[用户名]\n{user_name}\n\n[群组ID]\n{group_id}\n\n[最近上下文]\n{history}\n\n[当前消息]\n{message}\n\n[判定规则]\n1) 用户明确表示“别回复/不用回/闭嘴/停下”等，输出 F。\n2) 当前消息仅为收尾确认（如“嗯/好/知道了/收到/晚安/拜拜/谢谢”）且没有新问题或新任务，输出 F。\n3) 含有新的问题、任务、追问，或明确要求继续，输出 T。\n4) 不确定时优先输出 T，避免漏回关键请求。\n\n[输出格式]\n只能输出一个大写字母：T 或 F。",
                        "hint": "支持占位符：{time}、{user_id}、{user_name}、{group_id}、{history}、{message}、{persona}、{rN}、{schedule}（需安装 life_scheduler 插件）。"
                    },
                    "wake_judge_context_count": {
                        "description": "唤醒判定上下文条数",
                        "hint": "唤醒判定与唤醒延长共用的上下文条数。默认 10，且不会超过“上下文记录上限”。",
                        "type": "int",
                        "default": 10,
                        "slider": {
                            "min": 0,
                            "max": 50,
                            "step": 5
                        }
                    },
                    "wake_judge_timeout_sec": {
                        "description": "唤醒判定超时（秒）",
                        "hint": "唤醒判定的模型等待时间。超时后直接放行。设为 0 不启用。",
                        "type": "float",
                        "default": 5,
                        "slider": {
                            "min": 0,
                            "max": 30,
                            "step": 1
                        }
                    }
                }
            },
            "wake_extend": {
                "type": "object",
                "description": "唤醒延长",
                "hint": "LLM 响应后延长窗口内的唤醒维持。",
                "items": {
                    "wake_extend_window": {
                        "description": "唤醒延长窗口（秒）",
                        "hint": "LLM 响应后，在此时间窗口内可继续维持唤醒状态。设为 0 时关闭。",
                        "type": "int",
                        "default": 30,
                        "slider": {
                            "min": 0,
                            "max": 300,
                            "step": 5
                        }
                    },
                    "wake_extend_same_user_only": {
                        "description": "唤醒延长仅对原用户生效",
                        "hint": "开启后，唤醒延长窗口内仅处理上次触发请求的用户消息，忽略其他用户。",
                        "type": "bool",
                        "default": true
                    },
                    "wake_extend_similarity": {
                        "description": "唤醒延长相关性阈值",
                        "hint": "唤醒延长期间，当前消息与上文的相关性阈值。",
                        "type": "float",
                        "default": 0.12,
                        "slider": {
                            "min": 0,
                            "max": 1,
                            "step": 0.1
                        }
                    },
                    "wake_extend_provider_id": {
                        "description": "唤醒延长判定 Provider ID",
                        "type": "string",
                        "_special": "select_provider",
                        "default": "",
                        "hint": "留空时不启用模型判定。配置后会让该模型仅输出 T/F，用于判断是否继续响应。"
                    },
                    "wake_extend_judge_prompt": {
                        "description": "唤醒延长判定提示词",
                        "type": "text",
                        "obvious_hint": true,
                        "editor_mode": true,
                        "editor_language": "markdown",
                        "editor_theme": "vs-dark",
                        "default": "请判断当前消息是否与上文足够相关，是否需要继续响应。\n\n[当前时间]\n{time}\n\n[用户ID]\n{user_id}\n\n[用户名]\n{user_name}\n\n[群组ID]\n{group_id}\n\n[相关性阈值参考]\n{threshold}\n\n[上文]\n{history}\n\n[当前消息]\n{message}\n\n[判定规则]\n1) 如果当前消息是对上文的自然追问、补充、纠正、承接或继续讨论，输出 T。\n2) 如果当前消息与上文明显无关、话题跳转过大，或不需要机器人继续响应，输出 F。\n3) 不确定时优先结合上文连续性判断；只有在明显无关时才输出 F。\n\n[输出格式]\n只能输出一个大写字母：T 或 F。",
                        "hint": "支持占位符：{time}、{user_id}、{user_name}、{group_id}、{threshold}、{history}、{message}、{persona}、{rN}、{schedule}。仅在配置了 唤醒延长判定 Provider ID 时生效。"
                    },
                    "wake_extend_timeout_sec": {
                        "description": "唤醒延长判定超时（秒）",
                        "hint": "唤醒延长判定的模型等待时间。超时后回退到本地相似度判定。设为 0 不启用。",
                        "type": "float",
                        "default": 10,
                        "slider": {
                            "min": 0,
                            "max": 60,
                            "step": 1
                        }
                    }
                }
            },
            "wake_filter": {
                "type": "object",
                "description": "唤醒过滤",
                "hint": "唤醒屏蔽与机器人消息处理。",
                "items": {
                    "wake_forbidden_words": {
                        "description": "屏蔽唤醒规则",
                        "hint": "支持格式同唤醒规则。命中规则时不会唤醒 Bot。",
                        "type": "list",
                        "default": []
                    },
                    "quote_block_keywords": {
                        "description": "引用消息屏蔽规则",
                        "hint": "命中被引用消息（纯文本或分享卡片）中的规则时直接屏蔽该请求。格式同屏蔽唤醒规则，留空表示不启用。",
                        "type": "list",
                        "default": []
                    },
                    "require_at_for_wake_prefix": {
                        "description": "唤醒需 @Bot",
                        "hint": "开启后，仅通过唤醒前缀触发的 LLM 请求会被拦截，必须 @Bot 或引用 Bot 消息才放行。",
                        "type": "bool",
                        "default": false
                    },
                    "bot_account_ids": {
                        "description": "机器人 ID",
                        "hint": "配置其他机器人的用户 ID。",
                        "type": "list",
                        "default": []
                    },
                    "bot_account_skip_wake_types": {
                        "description": "机器人消息跳过类型",
                        "hint": "来自其他机器人的消息将跳过所选唤醒逻辑。",
                        "type": "list",
                        "options": [
                            "explicit",
                            "active",
                            "wake_extend"
                        ],
                        "labels": [
                            "显式唤醒",
                            "主动唤醒",
                            "唤醒延长"
                        ],
                        "default": []
                    }
                }
            }
        }
    },
    "request_orchestration": {
        "type": "object",
        "description": "请求编排",
        "hint": "控制 LLM 请求的合并策略与并发上限。",
        "items": {
            "merge": {
                "type": "object",
                "description": "消息合并",
                "hint": "配置消息合并策略、窗口与数量限制。",
                "items": {
                    "merge_dynamic_mode": {
                        "description": "合并模式",
                        "hint": "硬合并：按合并延迟做等待收集；动态合并：检测到新消息时丢弃上一轮响应并在下一轮合并重算。",
                        "type": "string",
                        "options": [
                            "hard",
                            "dynamic"
                        ],
                        "labels": [
                            "硬合并",
                            "动态合并"
                        ],
                        "default": "dynamic"
                    },
                    "merge_delay": {
                        "description": "合并窗口（秒）",
                        "hint": "硬合并下表示硬等待时间；动态合并下表示可并入消息的时间窗口上限。设为 0 时不启用消息合并。",
                        "type": "int",
                        "default": 0,
                        "slider": {
                            "min": 0,
                            "max": 60,
                            "step": 1
                        }
                    },
                    "merge_max_count": {
                        "description": "合并数量上限",
                        "hint": "单次最多可合并的消息条数，超过上限后将停止继续收集。",
                        "type": "int",
                        "default": 2,
                        "slider": {
                            "min": 0,
                            "max": 8,
                            "step": 1
                        }
                    },
                    "merge_premerge_window": {
                        "description": "预合并窗口（秒）",
                        "hint": "唤醒前，将在此窗口秒数内的用户消息作为预合并候选。仅动态合并模式生效，设为 0 时关闭预合并。",
                        "type": "int",
                        "default": 0,
                        "slider": {
                            "min": 0,
                            "max": 60,
                            "step": 1
                        }
                    },
                    "merge_followup_require_wake": {
                        "description": "后续合并需再次唤醒",
                        "hint": "开启后，仅并入满足唤醒条件的后续消息；关闭时并入窗口内任意后续消息。",
                        "type": "bool",
                        "default": false
                    },
                    "merge_multi_user": {
                        "description": "允许合并多人消息",
                        "hint": "开启后，合并窗口期间若有其他群成员发送消息，也会被一并收集。",
                        "type": "bool",
                        "default": false
                    }
                }
            },
            "concurrency": {
                "type": "object",
                "description": "并发控制",
                "hint": "配置用户级与群聊级的并发上限。",
                "items": {
                    "max_user_concurrent_requests": {
                        "description": "用户级并发请求上限",
                        "hint": "限制单个用户同时进行中的 LLM 请求数。设为 0 表示不限制。",
                        "type": "int",
                        "default": 0
                    },
                    "max_group_concurrent_requests": {
                        "description": "群聊级并发请求上限",
                        "hint": "限制单个群同时进行中的 LLM 请求数。设为 0 表示不限制。",
                        "type": "int",
                        "default": 0
                    },
                    "group_sender_concurrency": {
                        "description": "群聊按用户并发",
                        "hint": "开启后，同群内不同用户的 LLM 请求各自独立排队，不再全局串行等待，可同时进行处理。同一用户连续发消息仍然串行。若同时开启了动态合并 + 多人合并，此功能将不会生效。",
                        "type": "bool",
                        "default": false
                    }
                }
            }
        }
    },
    "context_injection": {
        "type": "object",
        "description": "上下文注入",
        "hint": "用于记录并注入群聊对话上下文，为后续读空气与主动唤醒优化提供基础数据。",
        "items": {
            "context_injection_mode": {
                "description": "上下文注入模式",
                "hint": "控制轻量上下文记录与注入策略。",
                "type": "string",
                "options": [
                    "off",
                    "before_active_only",
                    "before_all_wake"
                ],
                "labels": [
                    "不启用",
                    "仅主动唤醒前",
                    "所有唤醒前"
                ],
                "default": "off"
            },
            "context_injection_max_messages": {
                "description": "上下文记录上限",
                "hint": "每个会话最多保留的上下文消息条数。设为 0 可关闭上下文记录。",
                "type": "int",
                "default": 20,
                "slider": {
                    "min": 0,
                    "max": 50,
                    "step": 5
                }
            },
            "context_injection_format": {
                "description": "上下文注入格式",
                "hint": "简洁：仅注入时间+发送者+文本（含引用摘要），适合日常对话上下文；详细：注入完整结构字段（含 msg_id、@信息、reply 信息等），适合工具调用场景。",
                "type": "string",
                "options": [
                    "simple",
                    "detailed"
                ],
                "labels": [
                    "简洁",
                    "详细"
                ],
                "default": "simple"
            },
            "context_injection_non_text_parse_options": {
                "description": "非文本消息解析选项",
                "hint": "控制上下文记录阶段对非文本消息的处理方式。未勾选时使用占位符。聊天记录仅抽取文本，不做媒体解析。",
                "type": "list",
                "options": [
                    "image",
                    "record",
                    "forward",
                    "url",
                    "file",
                    "json"
                ],
                "labels": [
                    "图片",
                    "语音",
                    "聊天记录",
                    "URL",
                    "文件",
                    "JSON"
                ],
                "default": []
            },
            "context_line_max_length": {
                "description": "上下文条目截断长度",
                "hint": "每条上下文文本的最大字符数，超出部分截断。仅对简洁模式生效。",
                "type": "int",
                "default": 150
            },
            "context_injection_image_caption_provider_id": {
                "description": "上下文图像转述 Provider ID",
                "type": "string",
                "_special": "select_provider",
                "default": "",
                "hint": "留空时自动选择具备图片能力的 Provider。"
            }
        }
    },
    "parse_switches": {
        "type": "object",
        "description": "解析总开关",
        "hint": "统一控制各类内容解析能力是否启用。",
        "items": {
            "gif_parse_enable": {
                "description": "启用 GIF 解析",
                "type": "bool",
                "default": true,
                "hint": "按 GIF 处理模式的设定解析动图。关闭后跳过 GIF 解析。"
            },
            "video_parse_enable": {
                "description": "启用视频解析",
                "type": "bool",
                "default": true,
                "hint": "按视频处理模式的设定解析视频。关闭后跳过视频解析。"
            },
            "record_parse_enable": {
                "description": "启用语音解析",
                "type": "bool",
                "default": true,
                "hint": "按音频处理模式的设定处理语音消息。关闭后跳过语音解析。"
            },
            "forward_parse_enable": {
                "description": "启用聊天记录解析",
                "type": "bool",
                "default": true,
                "hint": "解析合并转发消息的内容。关闭后跳过聊天记录解析。"
            },
            "file_parse_enable": {
                "description": "启用文件解析",
                "type": "bool",
                "default": true,
                "hint": "提取引用消息中的文件信息注入给主模型。关闭后跳过文件解析。"
            },
            "json_parse_enable": {
                "description": "启用 JSON 卡片解析",
                "type": "bool",
                "default": true,
                "hint": "提取引用消息中的分享卡片标题、摘要、链接等信息注入给主模型。关闭后跳过 JSON 卡片解析。"
            },
            "url_parse_enable": {
                "description": "启用 URL 解析",
                "type": "bool",
                "default": true,
                "hint": "抓取并注入消息中的 URL 内容摘要。关闭后跳过 URL 解析。"
            }
        }
    },
    "media_parse": {
        "type": "object",
        "description": "媒体解析策略",
        "hint": "GIF / 视频 / 音频 三个子模块，各自独立配置。",
        "items": {
            "gif": {
                "type": "object",
                "description": "GIF 解析",
                "hint": "GIF 动图的解析模式与抽帧参数。",
                "items": {
                    "mode": {
                        "description": "GIF 处理模式",
                        "type": "string",
                        "options": [
                            "direct",
                            "frame_pass",
                            "full_analysis"
                        ],
                        "labels": [
                            "直送描述",
                            "抽帧直传",
                            "逐帧汇总"
                        ],
                        "default": "full_analysis",
                        "hint": "直送描述：原始 GIF 直送视觉模型做单次描述（需模型支持 GIF 格式）。抽帧直传：抽帧后所有 JPEG 直接供主模型自己看图。逐帧汇总：逐帧识图 + LLM 汇总后注入摘要。"
                    },
                    "frame_interval_sec": {
                        "description": "GIF 抽帧间隔（秒）",
                        "type": "float",
                        "default": 0.5,
                        "hint": "抽帧直传 / 逐帧汇总 模式下每隔 N 秒抽一帧。间隔越小越精细，但帧数越多。",
                        "slider": {
                            "min": 0.1,
                            "max": 3,
                            "step": 0.1
                        }
                    },
                    "max_frames": {
                        "description": "GIF 最大抽帧数",
                        "type": "int",
                        "default": 3,
                        "hint": "抽帧直传 / 逐帧汇总 模式下最多抽取的帧数。抽帧间隔优先，此值为上限。",
                        "slider": {
                            "min": 1,
                            "max": 10,
                            "step": 1
                        }
                    },
                    "provider_id": {
                        "description": "GIF 视觉模型 Provider ID",
                        "type": "string",
                        "_special": "select_provider",
                        "default": "",
